# =============================================================================
# Servidor de provisionamento do Wissen Cars
# =============================================================================
# As URLs já vêm preenchidas com a infraestrutura da Wissen. Faltam só as quatro
# variáveis que estão vazias abaixo. Depois de preencher, rode:
#
#   npm run check:server
#
# Nunca versione o server/.env — ele está no .gitignore.
# =============================================================================

# --- Supabase (obrigatório) -------------------------------------------------
# A service role key ignora RLS: mantenha somente aqui, nunca no front-end.
# Project Settings › API › service_role (projeto wissen-cars-multitenant)
SUPABASE_URL=https://bhffexojdowetruhbpxs.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# URL onde o front-end roda (usada no CORS e no retorno do OAuth)
APP_URL=http://localhost:5173
PORT=8787

# --- Google Agenda (etapa 2) ------------------------------------------------
# console.cloud.google.com › APIs e serviços › Credenciais › ID do cliente OAuth
# (tipo "Aplicativo da Web"). Cadastre GOOGLE_REDIRECT_URI na mesma tela, em
# "URIs de redirecionamento autorizados", exatamente como está abaixo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/google/callback

# --- Chatwoot (etapa 3) -----------------------------------------------------
# URL pública (o http://wissen_chatwoot:3000 do banco é interno do Docker e só
# funciona para o n8n e a Evolution).
# Token: Super Admin › Platform Apps › novo app › Access Token.
CHATWOOT_BASE_URL=https://wissen-chatwoot.2kk4lp.easypanel.host
CHATWOOT_PLATFORM_TOKEN=

# --- Evolution API / WhatsApp (etapa 4) -------------------------------------
# A chave é a AUTHENTICATION_API_KEY global da instalação (a mesma do manager,
# em /manager). A URL também está em tenant_settings.evolution_base_url.
EVOLUTION_API_URL=https://wissen-evolution-api.2kk4lp.easypanel.host
EVOLUTION_API_KEY=

# Testar a etapa 4 (QR + comemoração) sem WhatsApp real: conecta sozinho em ~12s.
WISSEN_SIMULATE=false

# --- N8N --------------------------------------------------------------------
# Workflow "Wissen Cars - Provisionamento do App" (já criado e ativo no n8n).
N8N_PROVISIONING_WEBHOOK_URL=https://wissen-n8n.2kk4lp.easypanel.host/webhook/wissen-cars/provisionamento
# Opcional: enviado como "Authorization: Bearer ..." para o webhook
N8N_WEBHOOK_TOKEN=
